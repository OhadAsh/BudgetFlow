{
  "name": "budgetflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "מעקב הוצאות וחיסכון חודשי — client-side Hebrew personal finance tracker",
  "_xlsxCdnNote": "xlsx is installed from cdn.sheetjs.com (not npm semver) because the public registry is stuck at vulnerable 0.18.5 (prototype pollution CVE-2023-30533 + ReDoS CVE-2024-22363). Patched CE builds ship only as CDN tarballs — pin a specific version, never floating latest.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.24",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "2.1.9"
  }
}
